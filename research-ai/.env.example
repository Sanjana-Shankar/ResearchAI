VITE_AUTH0_DOMAIN=your-tenant.us.auth0.com
VITE_AUTH0_CLIENT_ID=your_client_id_here

# ── Backend ───────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── Airbyte ───────────────────────────────────────────────────────────────────
# Airbyte OSS base URL (default: http://localhost:8000)
AIRBYTE_URL=http://localhost:8000
# Basic auth credentials for Airbyte OSS (default: airbyte / password)
AIRBYTE_CLIENT_ID=airbyte
AIRBYTE_CLIENT_SECRET=password
# Connection IDs — copy from Airbyte UI → Connections
AIRBYTE_SLACK_CONNECTION_ID=
AIRBYTE_DRIVE_CONNECTION_ID=
